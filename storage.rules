rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function hasActiveGrant() {
      return firestore.exists(/databases/(default)/documents/accessGrants/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/accessGrants/$(request.auth.uid)).data.status == 'active' &&
        firestore.get(/databases/(default)/documents/accessGrants/$(request.auth.uid)).data.email == request.auth.token.email;
    }

    function canUseApp() {
      return signedIn() && (isAdmin() || hasActiveGrant());
    }

    function canReadProject(projectId) {
      let project = firestore.get(/databases/(default)/documents/projects/$(projectId)).data;
      return canUseApp() && (
        project.ownerId == request.auth.uid ||
        project.ownerUid == request.auth.uid ||
        (project.members is list && request.auth.uid in project.members)
      );
    }

    match /chat/{projectId}/{userId}/{fileName} {
      allow read: if canReadProject(projectId) || (canUseApp() && isAdmin());
      allow write: if canUseApp() && ((canReadProject(projectId) && request.auth.uid == userId) || isAdmin());
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}