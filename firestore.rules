rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function authEmail() {
      return signedIn() && request.auth.token.email != null ? request.auth.token.email : '';
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function hasActiveGrant(uid) {
      return exists(/databases/$(database)/documents/accessGrants/$(uid)) &&
        get(/databases/$(database)/documents/accessGrants/$(uid)).data.status == 'active' &&
        get(/databases/$(database)/documents/accessGrants/$(uid)).data.email == authEmail();
    }

    function canUseApp() {
      return signedIn() && (isAdmin() || hasActiveGrant(request.auth.uid));
    }

    function isSelf(uid) {
      return canUseApp() && request.auth.uid == uid;
    }

    function projectDoc(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId));
    }

    function isProjectOwner(projectId) {
      return canUseApp() && (
        projectDoc(projectId).data.ownerId == request.auth.uid ||
        projectDoc(projectId).data.ownerUid == request.auth.uid
      );
    }

    function canReadProject(projectId) {
      return canUseApp() && (
        isProjectOwner(projectId) ||
        request.auth.uid in projectDoc(projectId).data.members
      );
    }

    function validUserUpdate() {
      return request.resource.data.email is string &&
        request.resource.data.email == authEmail() &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.plan == resource.data.plan &&
        request.resource.data.planStatus == resource.data.planStatus &&
        request.resource.data.planSince == resource.data.planSince &&
        request.resource.data.planExpiresAt == resource.data.planExpiresAt &&
        request.resource.data.subscriptionRenewsAt == ('subscriptionRenewsAt' in resource.data ? resource.data.subscriptionRenewsAt : null) &&
        request.resource.data.subscriptionCancelAtPeriodEnd == ('subscriptionCancelAtPeriodEnd' in resource.data ? resource.data.subscriptionCancelAtPeriodEnd : false) &&
        request.resource.data.coinsBalance == resource.data.coinsBalance &&
        request.resource.data.stripeCustomerId == ('stripeCustomerId' in resource.data ? resource.data.stripeCustomerId : null) &&
        request.resource.data.stripeSubscriptionId == ('stripeSubscriptionId' in resource.data ? resource.data.stripeSubscriptionId : null);
    }

    match /users/{uid} {
      allow create: if false;
      allow read: if canUseApp() && (isSelf(uid) || isAdmin());
      allow update: if canUseApp() && isSelf(uid) && validUserUpdate();
      allow delete: if canUseApp() && (isSelf(uid) || isAdmin());
    }

    match /accessGrants/{uid} {
      allow read, write: if false;
    }

    match /invitations/{invitationId} {
      allow read, write: if false;
    }

    match /invitationRateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    match /invitationEmailLocks/{lockId} {
      allow read, write: if false;
    }

    match /projects/{projectId} {
      allow create: if canUseApp() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.members is list &&
        request.auth.uid in request.resource.data.members;
      allow read: if canReadProject(projectId) || (canUseApp() && isAdmin());
      allow update, delete: if isProjectOwner(projectId) || (canUseApp() && isAdmin());

      match /pages/{pageId} {
        allow read: if canReadProject(projectId) || (canUseApp() && isAdmin());
        allow create, update, delete: if isProjectOwner(projectId) || (canUseApp() && isAdmin());
      }
    }

    match /templates/{templateId} {
      allow read: if canUseApp();
      allow create, update, delete: if canUseApp() && isAdmin();
    }

    match /pageTemplates/{templateId} {
      allow read: if canUseApp();
      allow create, update, delete: if canUseApp() && isAdmin();
    }

    match /tickets/{ticketId} {
      allow create: if canUseApp() && request.resource.data.userId == request.auth.uid;
      allow read: if canUseApp() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if canUseApp() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /times/{timeId} {
      allow create: if canUseApp() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if canUseApp() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /tasks/{taskId} {
      allow create, delete: if canUseApp() && isAdmin();
      allow read: if canUseApp() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if canUseApp() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /projectChats/{projectId}/messages/{messageId} {
      allow read: if canReadProject(projectId) || (canUseApp() && isAdmin());
      allow create: if canReadProject(projectId) && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /projectChats_flat/{messageId} {
      allow read: if canUseApp() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /stripe_events/{eventId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}