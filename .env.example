# Example only.
# This file is NOT loaded by Next.js runtime.
# Put real values into .env.local locally or into Vercel Environment Variables.

# Firebase (Public)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_vapid_key

# AI (Server-side)
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Stripe Configuration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Stripe Price IDs
NEXT_PUBLIC_STRIPE_PRICE_COINS_50=your_price_id_coins_50
NEXT_PUBLIC_STRIPE_PRICE_COINS_80=your_price_id_coins_80
NEXT_PUBLIC_STRIPE_PRICE_COINS_100=your_price_id_coins_100
NEXT_PUBLIC_STRIPE_PRICE_COINS_150=your_price_id_coins_150
NEXT_PUBLIC_STRIPE_PRICE_COINS_300=your_price_id_coins_300
NEXT_PUBLIC_STRIPE_PRICE_SPAR_ABO=your_price_id_spar_abo
NEXT_PUBLIC_STRIPE_PRICE_STANDARD_ABO=your_price_id_standard_abo
NEXT_PUBLIC_STRIPE_PRICE_PREMIUM_ABO=your_price_id_premium_abo

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AppSchmiede

# Admin UIDs (comma separated)
NEXT_PUBLIC_ADMIN_UIDS=your_firebase_uid_here

# OAuth (Optional - only if using custom domains)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
NEXT_PUBLIC_GITHUB_CLIENT_ID=your_github_client_id
NEXT_PUBLIC_APPLE_CLIENT_ID=your_apple_client_id

# AdSense Slots
NEXT_PUBLIC_ADSENSE_SLOT_HOME_LEFT_PRIMARY=your_adsense_slot_home_left_primary
NEXT_PUBLIC_ADSENSE_SLOT_HOME_LEFT_SECONDARY=your_adsense_slot_home_left_secondary
NEXT_PUBLIC_ADSENSE_SLOT_HOME_RIGHT_PRIMARY=your_adsense_slot_home_right_primary
NEXT_PUBLIC_ADSENSE_SLOT_HOME_RIGHT_SECONDARY=your_adsense_slot_home_right_secondary
NEXT_PUBLIC_ADSENSE_SLOT_DASH_LEFT_PRIMARY=your_adsense_slot_dash_left_primary
NEXT_PUBLIC_ADSENSE_SLOT_DASH_LEFT_SECONDARY=your_adsense_slot_dash_left_secondary
NEXT_PUBLIC_ADSENSE_SLOT_DASH_RIGHT_PRIMARY=your_adsense_slot_dash_right_primary
NEXT_PUBLIC_ADSENSE_SLOT_DASH_RIGHT_SECONDARY=your_adsense_slot_dash_right_secondary
